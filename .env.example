# Copy this file to ".env" and fill in your key. Never commit ".env".
# Get a key at https://aistudio.google.com/apikey
#
# These are read by the backend (server/) via dotenv. The key stays server-side
# and is never exposed to the browser. On Replit, add GEMINI_API_KEY as a Secret.

GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash. Other options: gemini-2.5-flash-lite, gemini-2.5-pro
# (Note: gemini-2.0-flash has no free-tier quota on some projects — use a 2.5 model.)
GEMINI_MODEL=gemini-2.5-flash
# Port the Gemini API server listens on (the Vite dev server proxies /api to it).
PORT=3001
